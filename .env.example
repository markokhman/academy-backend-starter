# Окружение: production | development
ENVIRONMENT=development
DEBUG=true

# PostgreSQL: либо локальный (db.docker-compose.yml), либо Supabase, либо managed-инстанс.
# Формат: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://academy:academy@localhost:5432/academy

# Telegram bot — тот же токен, что в bot-starter/.env!
# Без него мы не сможем проверить подпись initData от миниапки.
BOT_TOKEN=

# URL бота для отправки пушей (стартер bot-starter).
# Бот слушает на PUSH_SERVER_PORT (по умолчанию 8080).
BOT_PUSH_URL=http://localhost:8080

# Секрет для внутренней связи бот ↔ бэкенд. Должен совпадать с PUSH_INTERNAL_TOKEN в bot-starter/.env.
PUSH_INTERNAL_TOKEN=change-me-to-a-long-random-string

# Сколько часов считать initData валидной. Telegram рекомендует 24 часа.
INIT_DATA_TTL_HOURS=24

# CORS: разрешённые origins миниапки. Для DEV — "*". Для прода — конкретный домен.
CORS_ALLOW_ORIGINS=*

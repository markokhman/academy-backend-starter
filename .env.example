# === Окружение ===
# Vibe Coding Academy использует три окружения:
#   dev    — локально на твоём компе, эксперименты, можно ломать
#   beta   — для 30-60 бета-тестеров (отдельный бот, отдельная БД)
#   public — продакшен, реальные пользователи (отдельный бот, отдельная БД)
#
# Подробности — в concepts/environments.md.
# Никогда не миксуй окружения: bot_token + database_url + mini_app_url одного окружения.
ENVIRONMENT=dev
DEBUG=true

# === База данных ===
# Рекомендуем Supabase (https://supabase.com) — отдельный проект под каждое окружение.
# Project Settings → Database → Connection string → Transaction Pooler → URI.
# Формат: postgresql+asyncpg://postgres.<ref>:<password>@<host>:6543/postgres
#
# Альтернатива для dev: локальный Postgres из docker-compose (make db-up).
DATABASE_URL=postgresql+asyncpg://academy:academy@localhost:5432/academy

# === Telegram-бот ===
# КРИТИЧНО: BOT_TOKEN должен быть ОДИН И ТОТ ЖЕ в bot-starter/.env и backend-starter/.env
# в рамках одного окружения. Иначе подпись Telegram initData не пройдёт верификацию.
#
# Создай ТРИ бота в @BotFather: dev / beta / public — у каждого свой токен.
# Сюда вставь токен бота ТЕКУЩЕГО окружения (которое выше в ENVIRONMENT).
BOT_TOKEN=

# URL бота для отправки пушей (стартер bot-starter, listens on PUSH_SERVER_PORT).
BOT_PUSH_URL=http://localhost:8080

# Секрет для внутренней связи бэкенд → бот. Должен совпадать с PUSH_INTERNAL_TOKEN
# в bot-starter/.env. В каждом окружении — свой уникальный.
PUSH_INTERNAL_TOKEN=change-me-to-a-long-random-string

# === Прочее ===
# Сколько часов считать initData валидной. Telegram рекомендует 24 часа.
INIT_DATA_TTL_HOURS=24

# CORS: разрешённые origins миниапки.
#   dev    → "*"
#   beta   → URL миниапки на Vercel/др. (например https://beta.beauty-ai.vercel.app)
#   public → URL миниапки в проде
CORS_ALLOW_ORIGINS=*
